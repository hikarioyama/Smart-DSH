{
  "name": "dsh-notify-push",
  "version": "0.1.0",
  "private": true,
  "description": "Web Push notifications for DeepSeek Harness ask_user_question requests (Android Chrome)",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "sw",
    "tests",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-commands"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": "0.2.0-rc.2 || 0.2.1-alpha.1",
      "profiles": [
        "web"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "web-push": "^3.6.7"
  }
}
