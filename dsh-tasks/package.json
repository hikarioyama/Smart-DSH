{
  "name": "dsh-tasks",
  "version": "0.1.0",
  "private": true,
  "description": "Task delegation for DeepSeek Harness: four roles, sibling hub, durable logs, and a subagent tab",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./core": {
      "default": "./lib/core.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "agents",
    "tests",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": "0.2.0-rc.2 || 0.2.1-alpha.1",
      "profiles": [
        "web"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2 || 0.2.1-alpha.1"
  }
}
